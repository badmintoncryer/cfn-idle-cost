          "rules": [
            {
              "help": {
                "text": "Its idle cost is in the total. Delete it, size it down, or check that it is needed in this environment."
              },
              "id": "idle-cost",
              "shortDescription": {
                "text": "Resource that costs money while idle"
              }
            },
            {
              "help": {
                "text": "A value the template doesn't say (a Parameter, a reference to another stack) or a case cfn-idle-cost does not support yet. It is not in the total."
              },
              "id": "could-not-estimate",
              "shortDescription": {
                "text": "Resource whose idle cost could not be estimated"
              }
            },
            {
              "help": {
                "text": "cfn-idle-cost has no rule for this type yet. It is not in the total."
              },
              "id": "not-counted",
              "shortDescription": {
